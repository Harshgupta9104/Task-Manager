# Copy this file to .env and adjust as needed.
#
# Base URL for the backend API. All requests in src/services/api.ts are built
# from this value. Leave unset in development to use the same-origin '/api/v1'
# path, which the Vite dev server proxies to http://localhost:8000.
#
# Set it when the frontend and backend are served from different origins, e.g.:
# VITE_API_URL=http://localhost:8000/api/v1
# VITE_API_URL=https://task-manager-y9as.onrender.com/api/v1
#
# PRODUCTION DEPLOYMENT GUIDE:
# 1. For Vercel + Render deployment:
#    - Build on Vercel requires VITE_API_URL set
#    - In Vercel Project Settings > Environment Variables, add:
#      - VITE_API_URL = https://[your-render-backend].onrender.com/api/v1
#    - Vercel will use this during `npm run build`
#    - Result: Frontend will call your Render backend API
#
# 2. For same-origin deployment (both on same server):
#    - Leave VITE_API_URL empty
#    - Frontend will use relative path /api/v1
#    - Works if backend serves /api/v1 on same domain
VITE_API_URL=
