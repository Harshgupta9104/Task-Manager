# Production environment configuration
# 
# IMPORTANT: Set this to your deployed backend URL when building for production.
# For Render backend, use the format: https://your-app.onrender.com/api/v1
#
# If deploying on Vercel, set this as an environment variable in Vercel dashboard:
# - Go to Project Settings > Environment Variables
# - Add VITE_API_URL with value: https://[your-render-backend-url]/api/v1
#
# Example for development testing:
# VITE_API_URL=http://localhost:8000/api/v1
#
# Leave this empty ONLY if frontend and backend are served from same origin
VITE_API_URL=
